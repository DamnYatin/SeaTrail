  "components": {
    "schemas": {
      "CaseClassification": {
        "type": "string",
        "enum": [
          "RESTRICTED",
          "CONFIDENTIAL",
          "INTERNAL"
        ],
        "title": "CaseClassification"
      },
      "CaseCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "classification": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CaseClassification"
              }
            ],
            "default": "CONFIDENTIAL"
          },
          "lead_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lead User Id"
          },
          "retention_policy_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retention Policy Id"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CaseCreate"
      },
      "CaseMemberCreate": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "case_role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CaseMemberRole"
              }
            ],
            "default": "MEMBER"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "CaseMemberCreate"
      },
      "CaseMemberResponse": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "case_role": {
            "$ref": "#/components/schemas/CaseMemberRole"
          },
          "added_by": {
            "type": "string",
            "title": "Added By"
          },
          "added_at": {
            "type": "string",
            "format": "date-time",
            "title": "Added At"
          },
          "user_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Email"
          },
          "user_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Name"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "user_id",
          "case_role",
          "added_by",
          "added_at"
        ],
        "title": "CaseMemberResponse"
      },
      "CaseMemberRole": {
        "type": "string",
        "enum": [
          "LEAD",
          "MEMBER",
          "OBSERVER"
        ],
        "title": "CaseMemberRole"
      },
      "CaseResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "case_number": {
            "type": "string",
            "title": "Case Number"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "status": {
            "$ref": "#/components/schemas/CaseStatus"
          },
          "classification": {
            "$ref": "#/components/schemas/CaseClassification"
          },
          "lead_user_id": {
            "type": "string",
            "title": "Lead User Id"
          },
          "evidence_counter": {
            "type": "integer",
            "title": "Evidence Counter"
          },
          "legal_hold": {
            "type": "boolean",
            "title": "Legal Hold"
          },
          "legal_hold_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Legal Hold Reason"
          },
          "retention_policy_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retention Policy Id"
          },
          "opened_at": {
            "type": "string",
            "format": "date-time",
            "title": "Opened At"
          },
          "closed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Closed At"
          },
          "created_by": {
            "type": "string",
            "title": "Created By"
          }
        },
        "type": "object",
        "required": [
          "id",
          "case_number",
          "name",
          "status",
          "classification",
          "lead_user_id",
          "evidence_counter",
          "legal_hold",
