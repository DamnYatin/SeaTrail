        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CaseResponse"
                  },
                  "type": "array",
                  "title": "Response List Cases Api V1 Cases Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "Cases"
        ],
        "summary": "Create Case",
        "description": "Create a new case, assign case number, and register creator as Lead.",
