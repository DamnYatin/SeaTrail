# =====================================================================
# SealTrail - environment template (.env.example)
# Copy to .env at repo root and populate secrets, or run:
# python backend/scripts/gen_secrets.py
# =====================================================================

# ---- PostgreSQL ----------------------------------------------------
POSTGRES_DB=sealtrail
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_USER=sealtrail_owner
DB_OWNER_PASSWORD=
DB_APP_USER=sealtrail_app
DB_APP_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL_APP=postgresql+psycopg://sealtrail_app:@postgres:5432/sealtrail
DATABASE_URL_OWNER=postgresql+psycopg://sealtrail_owner:@postgres:5432/sealtrail
DATABASE_URL_SUPERUSER_HOST=postgresql+psycopg://postgres:@127.0.0.1:5432/sealtrail

# ---- S3-compatible storage (MinIO) ---------------------------------
MINIO_ROOT_USER=minio_root_admin
MINIO_ROOT_PASSWORD=
S3_ENDPOINT_URL=http://minio:9000
S3_ENDPOINT_URL_HOST=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_EVIDENCE=sealtrail-evidence
S3_BUCKET_EXPORTS=sealtrail-exports
S3_APP_ACCESS_KEY=sealtrail_app_svc
S3_APP_SECRET_KEY=
S3_DISPOSER_ACCESS_KEY=sealtrail_disposer_svc
S3_DISPOSER_SECRET_KEY=

# ---- Application ---------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
COOKIE_SECURE=false
MAX_UPLOAD_MB=200
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=10
PASSWORD_MIN_LENGTH=10

# ---- Audit chain / signing (Ed25519) ---------------------------------
CHECKPOINT_SIGNING_KEY_B64=
CHECKPOINT_PUBLIC_KEY_B64=
CHECKPOINT_INTERVAL_MINUTES=5
CHAIN_VERIFY_INTERVAL_MINUTES=5

# ---- Custody workflow / anomaly rules -------------------------------
ACK_SLA_MINUTES=60
BUSINESS_TZ=Asia/Kolkata
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=20:00
BURST_VIEW_THRESHOLD=15
BURST_WINDOW_MINUTES=5
DENIED_ATTEMPTS_THRESHOLD=3
DENIED_WINDOW_MINUTES=10
APPROVAL_EXPIRY_HOURS=48
DEFAULT_RETENTION_DAYS=1825

# ---- Seed data (synthetic) -------------------------------------------
SEED_ON_START=false
SEED_PASSWORD=
SEED_EMAIL_DOMAIN=sealtrail.local
